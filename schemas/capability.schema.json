          "type": "string"
        }
      },
      "required": [
        "product",
        "versions"
      ],
      "title": "AppBinding",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "title": "Approved By",
          "type": "string"
        },
        "approved_at": {
          "title": "Approved At",
          "type": "string"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "approved_by",
        "approved_at",
        "content_sha256"
      ],
      "title": "Approval",
      "type": "object"
    },
    "AttrStrategy": {
      "additionalProperties": false,
      "description": "Stable markup attributes (name, type, alt, href path...). Auto-generated\nlooking ids are rejected at record time.",
