        "param": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Param",
          "type": "string"
        }
      },
      "required": [
        "param"
      ],
      "title": "ParamRef",
      "type": "object"
    },
    "PatternArgs": {
      "additionalProperties": false,
      "properties": {
        "container": {
          "items": {
            "type": "string"
          },
          "title": "Container",
          "type": "array"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "PatternArgs",
      "type": "object"
    },
    "Provenance": {
