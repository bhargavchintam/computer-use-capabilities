        "equals": {
          "oneOf": [
            {
              "$ref": "#/$defs/ParamRef"
            },
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "$ref": "#/$defs/LiteralValue"
            }
          ],
          "title": "Equals"
        }
      },
      "required": [
        "equals"
      ],
      "title": "FieldValueArgs",
      "type": "object"
    },
    "Fingerprint": {
      "additionalProperties": false,
