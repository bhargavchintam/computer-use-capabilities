      "type": "object"
    },
    "Implementation": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "$ref": "#/$defs/AppBinding"
        },
        "entry": {
          "$ref": "#/$defs/Entry"
        },
        "preconditions": {
          "items": {
            "const": "authenticated_session",
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "outcome_detectors": {
          "additionalProperties": {
            "$ref": "#/$defs/OutcomeDetector"
          },
          "title": "Outcome Detectors",
          "type": "object"
        },
        "success": {
          "oneOf": [
            {
              "$ref": "#/$defs/TextVisible"
            },
            {
              "$ref": "#/$defs/TextMatches"
            },
            {
              "$ref": "#/$defs/DocumentChanged"
            },
            {
              "$ref": "#/$defs/UrlMatches"
            },
            {
              "$ref": "#/$defs/ElementPresent"
            },
            {
              "$ref": "#/$defs/FieldValue"
            },
            {
              "$ref": "#/$defs/OutputsPresent"
            },
            {
              "$ref": "#/$defs/AllOf"
            },
            {
              "$ref": "#/$defs/AnyOf"
            }
          ],
          "title": "Success"
        }
      },
      "required": [
        "app",
        "entry",
        "steps",
        "success"
      ],
      "title": "Implementation",
      "type": "object"
    },
    "InputSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "money",
            "date",
            "enum"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "enum": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enum"
        },
        "max_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Value"
        },
        "sensitivity": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "pii_identifier",
            "pii",
            "confidential"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "description"
      ],
      "title": "InputSpec",
      "type": "object"
