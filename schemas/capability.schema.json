        "kind": {
          "const": "label",
          "default": "label",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "role",
        "label"
      ],
      "title": "LabelStrategy",
      "type": "object"
    },
    "LiteralValue": {
      "additionalProperties": false,
      "description": "A fixed UI value (e.g. a menu option). Linted so it can't smuggle data.",
      "properties": {
        "literal": {
          "title": "Literal",
          "type": "string"
        }
      },
      "required": [
        "literal"
      ],
      "title": "LiteralValue",
      "type": "object"
    },
    "OutcomeDetector": {
      "additionalProperties": false,
      "description": "How a declared outcome shows up on screen: a reference to the app profile's\nmessage catalog (shared across capabilities) or an inline condition.",
      "properties": {
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "when": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/TextVisible"
                },
                {
                  "$ref": "#/$defs/TextMatches"
                },
                {
                  "$ref": "#/$defs/DocumentChanged"
                },
                {
                  "$ref": "#/$defs/UrlMatches"
                },
                {
                  "$ref": "#/$defs/ElementPresent"
                },
                {
                  "$ref": "#/$defs/FieldValue"
                },
                {
                  "$ref": "#/$defs/OutputsPresent"
                },
                {
                  "$ref": "#/$defs/AllOf"
                },
                {
                  "$ref": "#/$defs/AnyOf"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        }
      },
      "title": "OutcomeDetector",
      "type": "object"
    },
    "OutcomeSpec": {
      "additionalProperties": false,
      "description": "A legitimate business result the caller must handle (not an error).\n\n``retry_safe`` says whether calling again with the same inputs could apply a change\ntwice (false e.g. when the app reports an earlier submission may have gone through).\nWhether a retry would *help* is what ``caller_guidance`` is for.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "caller_guidance": {
          "title": "Caller Guidance",
          "type": "string"
        },
        "retry_safe": {
          "default": true,
          "title": "Retry Safe",
          "type": "boolean"
        }
      },
      "required": [
        "description",
        "caller_guidance"
      ],
      "title": "OutcomeSpec",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "money",
            "date",
            "identifier",
            "table"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "columns": {
          "anyOf": [
            {
              "additionalProperties": {
                "enum": [
                  "string",
                  "integer",
                  "money",
                  "date",
                  "identifier"
                ],
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "sensitivity": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "pii_identifier",
            "pii",
            "confidential"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "type",
        "description"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
    "OutputsPresent": {
      "additionalProperties": false,
      "properties": {
        "outputs_present": {
          "items": {
            "type": "string"
