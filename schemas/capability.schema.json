        "kind": {
          "const": "role_name",
          "default": "role_name",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "role",
        "name"
      ],
      "title": "RoleName",
      "type": "object"
    },
    "RowKey": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "equals": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ParamRef"
            }
          ],
          "title": "Equals"
        }
      },
      "required": [
        "column",
        "equals"
      ],
      "title": "RowKey",
      "type": "object"
    },
    "SecretRef": {
      "additionalProperties": false,
      "description": "A credential resolved from the tenant's secret store at runtime; never stored.",
