        "kind": {
          "const": "attr",
          "default": "attr",
          "title": "Kind",
          "type": "string"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        },
        "attrs": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Attrs",
          "type": "object"
        }
      },
      "required": [
        "tag",
        "attrs"
      ],
      "title": "AttrStrategy",
      "type": "object"
    },
    "CallExample": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Input",
          "type": "object"
        },
        "output": {
          "additionalProperties": true,
          "title": "Output",
          "type": "object"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "title": "CallExample",
      "type": "object"
    },
    "ContainerArgs": {
      "additionalProperties": false,
      "properties": {
        "container": {
          "items": {
            "type": "string"
          },
          "title": "Container",
          "type": "array"
        }
      },
      "title": "ContainerArgs",
      "type": "object"
    },
    "Contract": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/InputSpec"
          },
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/OutputSpec"
          },
          "title": "Outputs",
          "type": "object"
        },
        "outcomes": {
          "additionalProperties": {
            "$ref": "#/$defs/OutcomeSpec"
          },
          "title": "Outcomes",
          "type": "object"
        },
        "effects": {
          "enum": [
            "read_only",
            "commit"
          ],
          "title": "Effects",
          "type": "string"
        },
        "idempotent": {
          "title": "Idempotent",
          "type": "boolean"
        },
        "example": {
          "anyOf": [
            {
              "$ref": "#/$defs/CallExample"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "inputs",
        "outputs",
        "effects",
        "idempotent"
      ],
      "title": "Contract",
      "type": "object"
    },
    "DialogExpectation": {
      "additionalProperties": false,
      "description": "A native dialog the flow expects at this step, and how to answer it.",
      "properties": {
        "match": {
          "title": "Match",
          "type": "string"
        },
        "action": {
          "enum": [
            "accept",
            "dismiss"
          ],
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "match",
        "action"
      ],
      "title": "DialogExpectation",
      "type": "object"
    },
    "DocumentChanged": {
      "additionalProperties": false,
      "description": "The container's document was replaced since the action started.\n\nLegacy postbacks re-render at the same URL, so URL checks alone can pass on\nthe *old* page; the init script stamps each document with a nonce instead.",
      "properties": {
        "document_changed": {
          "$ref": "#/$defs/ContainerArgs"
        }
      },
      "required": [
        "document_changed"
      ],
      "title": "DocumentChanged",
      "type": "object"
    },
    "ElementPresent": {
      "additionalProperties": false,
      "properties": {
        "element_present": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "element_present"
      ],
      "title": "ElementPresent",
      "type": "object"
    },
    "Entry": {
      "additionalProperties": false,
      "properties": {
        "route": {
          "title": "Route",
          "type": "string"
        }
      },
      "required": [
        "route"
      ],
      "title": "Entry",
      "type": "object"
    },
    "FieldValue": {
      "additionalProperties": false,
      "properties": {
