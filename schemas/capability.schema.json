            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment"
        },
        "trace_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Sha256"
        },
        "verified_by_runs": {
          "items": {
            "type": "string"
          },
          "title": "Verified By Runs",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "source",
        "recorded_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RoleName": {
      "additionalProperties": false,
      "description": "Role plus accessible name, e.g. link \"Member Inquiry\".",
