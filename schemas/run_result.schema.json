{
  "$defs": {
    "FailureInfo": {
      "properties": {
        "code": {
          "enum": [
            "INPUT_INVALID",
            "POLICY_DENIED",
            "NOT_APPROVED",
            "INCOMPATIBLE_VERSION",
            "CAPABILITY_INVALID",
            "TARGET_NOT_FOUND",
            "TARGET_NOT_ACTIONABLE",
            "AMBIGUOUS_TARGET",
            "TIMEOUT",
            "CHECKPOINT_FAILED",
            "UNRECOGNIZED_STATE",
            "APP_ERROR",
            "PERMISSION_DENIED",
            "AUTH_FAILED",
            "SESSION_LOST",
            "RESYNC_FAILED",
            "ABORTED_BY_OPERATOR",
            "DISCOVERY_STUCK",
            "INTERNAL"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "step_intent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Intent"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "observed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "transient": {
          "default": false,
          "title": "Transient",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "near_misses": {
          "items": {
            "type": "string"
          },
          "title": "Near Misses",
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "FailureInfo",
      "type": "object"
    },
    "HumanAction": {
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "container": {
          "items": {
            "type": "string"
          },
          "title": "Container",
          "type": "array"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "at": {
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "type",
        "target",
        "at"
      ],
      "title": "HumanAction",
      "type": "object"
    },
    "InterventionRecord": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "decision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision"
        },
        "operator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "requested_at": {
          "title": "Requested At",
          "type": "string"
        },
        "resolved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At"
        },
        "human_actions": {
          "items": {
            "$ref": "#/$defs/HumanAction"
          },
          "title": "Human Actions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "reason",
        "requested_at"
      ],
      "title": "InterventionRecord",
      "type": "object"
    },
    "OutcomeInfo": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "caller_guidance": {
          "title": "Caller Guidance",
          "type": "string"
        },
        "retry_safe": {
          "title": "Retry Safe",
          "type": "boolean"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        }
      },
      "required": [
        "code",
        "description",
        "caller_guidance",
        "retry_safe"
      ],
      "title": "OutcomeInfo",
      "type": "object"
    },
    "Parked": {
      "properties": {
        "intervention_id": {
          "title": "Intervention Id",
          "type": "string"
        },
        "deadline": {
          "title": "Deadline",
          "type": "string"
        },
        "session_retained": {
          "title": "Session Retained",
          "type": "boolean"
        },
        "request_path": {
          "title": "Request Path",
          "type": "string"
        }
      },
      "required": [
        "intervention_id",
        "deadline",
        "session_retained",
        "request_path"
      ],
      "title": "Parked",
      "type": "object"
    },
    "RecoveryRecord": {
      "properties": {
        "detector": {
          "title": "Detector",
          "type": "string"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Step Id"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "at": {
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "detector",
        "step_id",
        "action",
        "at"
      ],
      "title": "RecoveryRecord",
      "type": "object"
    },
    "StepReport": {
      "properties": {
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "done",
            "skipped",
            "completed_by_human",
            "outcome",
            "awaiting_human",
            "failed",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        },
        "strategy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strategy"
        },
        "attempts": {
          "default": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "duration_ms": {
          "default": 0,
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "required": [
        "step_id",
        "status"
      ],
      "title": "StepReport",
      "type": "object"
    },
    "WarningRecord": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "WarningRecord",
      "type": "object"
    }
  },
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "replay",
        "discovery"
      ],
      "title": "Mode",
      "type": "string"
    },
    "capability": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capability"
    },
    "tenant": {
      "title": "Tenant",
      "type": "string"
    },
    "effective_plan_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective Plan Sha256"
    },
    "overlays_applied": {
      "items": {
        "type": "string"
      },
      "title": "Overlays Applied",
      "type": "array"
    },
    "status": {
      "enum": [
        "succeeded",
        "business_outcome",
        "rejected",
        "needs_human",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "outputs": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outputs"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/OutcomeInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "side_effect": {
      "default": "none",
      "enum": [
        "none",
        "not_committed",
        "committed",
        "unknown"
      ],
      "title": "Side Effect",
      "type": "string"
    },
    "retry_safe": {
      "default": true,
      "title": "Retry Safe",
      "type": "boolean"
    },
    "recoveries": {
      "items": {
        "$ref": "#/$defs/RecoveryRecord"
      },
      "title": "Recoveries",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/WarningRecord"
      },
      "title": "Warnings",
      "type": "array"
    },
    "interventions": {
      "items": {
        "$ref": "#/$defs/InterventionRecord"
      },
      "title": "Interventions",
      "type": "array"
    },
    "parked": {
      "anyOf": [
        {
          "$ref": "#/$defs/Parked"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepReport"
      },
      "title": "Steps",
      "type": "array"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "duration_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "evidence_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Dir"
    },
    "path_sha256": {
      "description": "The path this run took: each step, how it ended, and which locator strategy matched.\n\nReplay is deterministic: the same capability on the same application state takes the\nsame path. Tests and the evidence generator run every scenario twice and compare this.",
      "readOnly": true,
      "title": "Path Sha256",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "mode",
    "tenant",
    "status",
    "started_at",
    "path_sha256"
  ],
  "title": "RunResult",
  "type": "object"
}
