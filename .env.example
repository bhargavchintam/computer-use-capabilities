# Copy to .env (git-ignored) and fill in.

# Needed only for discovery (the LLM run). Replay and tests never call a model.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
# CUA_MODEL=claude-opus-5

# Local mock bank. The mock server and the cua runtime both read these,
# so any values work; they exist to exercise secret handling end to end.
MOCK_ADMIN_TOKEN=change-me-admin
MOCK_SUPERVISOR_PIN=2468
PINECREST_OPERATOR_ID=teller01
PINECREST_OPERATOR_PASSWORD=change-me-pinecrest
LAKESIDE_OPERATOR_ID=teller07
LAKESIDE_OPERATOR_PASSWORD=change-me-lakeside
